# Copy to .env and enter your key locally.
GEMINI_API_KEY=
# Optional failover slots, each from a different project.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Set to false for text-only models; image content then uses OCR automatically.
MODEL_SUPPORTS_VISION=true
# For LLM_PROVIDER=openai-compatible only: API base URL, model ID and separate keys.
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_RESPONSE_FORMAT=json_object
LLM_TOKEN_PARAMETER=max_tokens
# Direct vision is the default; optional OCR modes are described in README.md.
OCR_MODE=off
# auto routes by MODEL_SUPPORTS_VISION. Explicit vision/text remain supported.
IMAGE_INPUT=auto
DATA_DIR=data
OUTPUT_DIR=outputs
CACHE_DIR=.cache/extractions
LLM_THINKING_LEVEL=low
LLM_MAX_OUTPUT_TOKENS=16384
REQUEST_TIMEOUT_SECONDS=240
MAX_ATTEMPTS=3
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20
MAX_IMAGE_PARTS=40
MAX_DOCUMENT_CHARS=150000
IMAGE_TILE_HEIGHT=1800
IMAGE_TILE_OVERLAP=150
API_BASE_URL=http://127.0.0.1:8000

